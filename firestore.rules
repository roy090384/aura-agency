rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connectivity test document
    match /test/connection {
      allow read: if true;
    }

    // User data trees
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Agency represented female players
      match /players/{playerId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) 
          && isValidId(playerId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 128
          && (!('contactPhone' in request.resource.data) || (request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 64))
          && (!('parentName' in request.resource.data) || (request.resource.data.parentName is string && request.resource.data.parentName.size() <= 128))
          && (!('assignedAgent' in request.resource.data) || (request.resource.data.assignedAgent is string && request.resource.data.assignedAgent.size() <= 128));
      }

      // Agency represented male / youth players
      match /malePlayers/{playerId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) 
          && isValidId(playerId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 128
          && (!('contactPhone' in request.resource.data) || (request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 64))
          && (!('parentName' in request.resource.data) || (request.resource.data.parentName is string && request.resource.data.parentName.size() <= 128))
          && (!('assignedAgent' in request.resource.data) || (request.resource.data.assignedAgent is string && request.resource.data.assignedAgent.size() <= 128));
      }

      // "In Talk With" scouting prospects
      match /prospects/{prospectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(prospectId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 128;
      }

      // Match minutes & goal involvement tracked players
      match /trackedPlayers/{trackedPlayerId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(trackedPlayerId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 128;
      }

      // International / foreign female prospects
      match /foreignProspects/{foreignProspectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(foreignProspectId)
          && request.resource.data.userId == userId
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() > 0
          && request.resource.data.fullName.size() <= 128;
      }

      // User preferences (currency, language, theme, transfer window date)
      match /settings/preferences {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && (!('nextTransferWindowDate' in request.resource.data) || (request.resource.data.nextTransferWindowDate is string && request.resource.data.nextTransferWindowDate.size() <= 32));
      }

      // Agent directory & contact settings
      match /settings/agents {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.agents is list
          && request.resource.data.agents.size() <= 20;
      }
    }
  }
}
